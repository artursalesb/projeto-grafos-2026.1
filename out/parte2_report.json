        "source": "Ajax",
        "target": "Porto",
        "cost": null,
        "path_length": 0,
        "time_ms": 0.059,
        "interpretation": "Esperado has_negative_cycle=True (validacao da deteccao)."
      },
      {
        "name": "SINTETICO: peso negativo SEM ciclo (Santos->Inter->Barca->PSG, custo 0)",
        "directed": true,
        "weights_can_be_negative": true,
        "has_negative_cycle": false,
        "source": "Santos",
        "target": "PSG",
